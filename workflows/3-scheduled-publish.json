          {
            "node": "Check daily limit: Instagram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish: Telegram": {
      "main": [
        [
          {
            "node": "Mark published (PATCH)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish: VK": {
      "main": [
        [
          {
            "node": "Mark published (PATCH)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check daily limit: Instagram": {
      "main": [
        [
          {
            "node": "Publish: Instagram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish: Instagram": {
      "main": [
        [
          {
            "node": "Mark published (PATCH)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark published (PATCH)": {
      "main": [
        [
          {
