{
  "name": "2 - Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "content-approval",
        "responseMode": "onReceived"
      },
      "id": "767940b5-3ada-4a48-a3c2-70766119bf95",
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "action",
              "value": "={{ $json.callback_query.data.split(':')[0] }}"
            },
            {
              "name": "post_id",
              "value": "={{ $json.callback_query.data.split(':')[1] }}"
            }
          ]
        }
      },
      "id": "6ca4f382-633f-498c-b0c7-6c5ad7f20243",
      "name": "Parse callback_data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        250,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.action }}",
              "value2": "approve"
            }
          ]
        }
      },
      "id": "409f9ce4-e2e0-4f28-830b-2f59e1bf267d",
