        "jsonBody": "={{ JSON.stringify({status: 'approved'}) }}"
      },
      "id": "d4c41423-18d0-4ea0-b786-4dcdb37b4bb4",
      "name": "Mark approved (PATCH)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        750,
        -100
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/posts?id=eq.{{ $json.post_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({status: 'rejected'}) }}"
      },
      "id": "02891021-bce5-4730-b501-e36e2cb9956b",
