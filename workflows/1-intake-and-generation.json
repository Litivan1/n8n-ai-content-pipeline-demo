      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const platforms = [\n  {platform: 'telegram', tone: 'casual, 150-200 words, 1-2 emoji, end with a question'},\n  {platform: 'vk', tone: 'informative, 250-350 words, 4-6 hashtags at the end'},\n  {platform: 'instagram', tone: 'hook in the first line, 100-150 words, 10-12 hashtags'},\n];\nreturn platforms.map(p => ({ json: { ...$input.item.json, ...p } }));"
      },
      "id": "d7533a16-6391-4b9e-a065-97be1124a45a",
      "name": "Fan out per platform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: \"llama-3.3-70b-versatile\", messages: [{role: \"user\", content: \"Write a social post for \" + $json.platform + \". Tone: \" + $json.tone + \". Use these facts only: \" + $json.summary + \". Match the style of these past examples: \" + JSON.stringify($json.style_examples)}]}) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 9000
            }
          }
        }
      },
